        {
          "id": "b467ecb0-665f-4142-a350-74b436c761c6",
          "name": "Execute an asynchronous write SQL query",
          "request": {
            "name": "Execute an asynchronous write SQL query",
            "description": {
              "content": "Executes an INSERT / UPDATE / DELETE query (passed in `q`) against `toBranch`, which is created from `fromBranch` if it does not exist. An empty query merges `fromBranch` into `toBranch`. Returns an `operation_name` to poll. Requires authentication.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":owner",
                ":database",
                "write",
                ":fromBranch",
                ":toBranch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "The write SQL query. An empty value merges fromBranch into toBranch."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "database",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fromBranch",
                  "description": "(Required) Source branch the destination branch is based on."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "toBranch",
                  "description": "(Required) Destination branch the write is committed to."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "authorization"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
